# Вариант tvbox. Скопируйте в .env и заполните своими значениями.

# --- OpenAI ---
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4.1-mini
# Транскрибация через OpenAI audio API (без локального Whisper)
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# --- yt-dlp cookies ---
# На коробке нет браузера → используем файл cookies (Netscape-формат, залогиненная сессия):
COOKIES_FILE=cookies.txt
# Для локальной разработки можно брать cookies из браузера:
# COOKIES_FROM_BROWSER=firefox

# --- Telegram-бот devtrade_bot ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# SQLite-файл (вариант tvbox). Для Postgres: postgresql+asyncpg://user:pass@host:5432/db
DATABASE_URL=sqlite+aiosqlite:///devtrade.db
WORKER_POLL_INTERVAL=3
# Таймаут запросов к Telegram (сек). На медленных каналах (tvbox) подними до 120+.
BOT_REQUEST_TIMEOUT=120

# Лимит длины генерируемого PineScript (строк)
PINE_MAX_LINES=120
